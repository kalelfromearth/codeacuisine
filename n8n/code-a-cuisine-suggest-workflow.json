    {
      "id": "b2e4a6c8-3d5f-4b71-9c2e-4f6a8b0d2c02",
      "name": "Validate query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json.query ? $input.first().json.query.q : '';\nconst q = typeof raw === 'string' ? raw.trim().replace(/\\s+/g, ' ') : '';\nconst valid = q.length >= 2 && q.length <= 30 && /^[\\p{L}][\\p{L} '\\-]*$/u.test(q);\nreturn [{ json: { q, valid } }];"
      }
    },
    {
      "id": "c3f5b7d9-4e60-4c82-8d3f-5a7b9c1e3d03",
      "name": "Is query valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [520, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "d4a6c8e0-5f71-4d93-9e40-6b8c0d2f4e04",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
