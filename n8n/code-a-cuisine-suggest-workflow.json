      "parameters": {}
    },
    {
      "id": "18e0a2c4-93b5-41d7-9c84-0f2a4b6d8c08",
      "name": "Clean suggestions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1820, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const fold = (text) => text.toLowerCase().replace(/ß/g, 'ss').normalize('NFD').replace(/[\u0300-\u036f]/g, '');\nconst q = $('Validate query').first().json.q;\nconst query = fold(q);\nconst answers = $input.all();\nconst failedCount = answers.filter((item) => item.json.error).length;\nif (failedCount === answers.length) {\n  return [{ json: { suggestions: [], unavailable: true } }];\n}\nconst unwanted = /pasteuri|aroma|flavour|flavor|konzentrat|concentrate|\\d|[(),%]/;\nconst seen = new Set();\nconst found = [];\nfor (const item of answers) {\n  const list = Array.isArray(item.json.suggestions) ? item.json.suggestions : [];\n  for (const entry of list) {\n    if (typeof entry !== 'string') continue;\n    const text = entry.trim();\n    const key = fold(text);\n    const words = key.split(/[\\s\\-]+/);\n    if (text.length < 2 || text.length > 25 || words.length > 3 || unwanted.test(key) || seen.has(key)) continue;\n    const rank = key.startsWith(query) ? 0 : words.some((word) => word.startsWith(query)) ? 1 : -1;\n    if (rank < 0) continue;\n    seen.add(key);\n    found.push({ text: text.charAt(0).toUpperCase() + text.slice(1), rank });\n  }\n}\nfound.sort((a, b) => a.rank - b.rank || a.text.length - b.text.length);\nconst suggestions = found.slice(0, 6).map((entry) => entry.text);\nif (failedCount === 0) {\n  const store = $getWorkflowStaticData('global');\n  const cache = store.suggestionCache || {};\n  cache[q.toLowerCase()] = { at: Date.now(), suggestions };\n  const keys = Object.keys(cache);\n  if (keys.length > 1500) {\n    keys.sort((a, b) => cache[a].at - cache[b].at).slice(0, keys.length - 1500).forEach((key) => delete cache[key]);\n  }\n  store.suggestionCache = cache;\n}\nreturn [{ json: { suggestions, unavailable: failedCount > 0 && suggestions.length === 0 } }];"
      }
    },
