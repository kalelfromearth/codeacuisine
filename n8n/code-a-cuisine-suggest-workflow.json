    },
    {
      "id": "4b13d5f7-c6e8-44a0-8fb7-3c5d7e9a1f11",
      "name": "Read cache",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const q = $input.first().json.q;\nconst cache = $getWorkflowStaticData('global').suggestionCache || {};\nconst hit = cache[q.toLowerCase()];\nconst isFresh = Boolean(hit) && Date.now() - hit.at < 24 * 60 * 60 * 1000;\nreturn [{ json: { q, isCached: isFresh, suggestions: isFresh ? hit.suggestions : [] } }];"
      }
    },
