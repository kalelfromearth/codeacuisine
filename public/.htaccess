# Apache settings for the domain root build (npm run build). Do not upload this file into the subfolder build.
# Every block is wrapped in IfModule, so a missing module skips the block instead of breaking the site.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Always use HTTPS. The second condition prevents a redirect loop when the host handles HTTPS in front of Apache.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Single page app: every path that is not a real file or folder is answered by index.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Compress text files on the way to the browser.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Security headers.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Files with a hash in their name never change, so the browser may keep them for a year.
  <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images, video and fonts may be kept for 30 days.
  <FilesMatch "\.(webp|svg|png|ico|mp4|ttf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # The page itself is always checked again, so a new upload is seen at once.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
